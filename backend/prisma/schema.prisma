generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  DISPATCHER
}

enum AlertStatus {
  PENDING
  DISPATCHED
  TRANSPORTING
  COMPLETED
  CANCELLED
}

// 1. User Entity
model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  role           Role            @default(PATIENT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  feedbacks      Feedback[]

  @@index([role])
}

// 2. DoctorProfile Entity
model DoctorProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  specialization String
  phoneNumber    String
  isOnDuty       Boolean   @default(true)
  isBusy         Boolean   @default(false)
  isAvailable    Boolean   @default(true)
  isActive       Boolean   @default(true)
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?
  hospitalId     Int?
  hospital       Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  dispatches     DispatchRecord[]

  @@index([isOnDuty, isBusy])
  @@index([isAvailable])
}

// 3. PatientProfile Entity
model PatientProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phoneNumber    String
  age            Int?
  gender         String?
  medicalHistory String?
  bloodGroup     String?

  alerts         EmergencyAlert[]
}

// 4. Hospital Entity
model Hospital {
  id             Int       @id @default(autoincrement())
  name           String
  address        String
  latitude       Float
  longitude      Float
  contactNumber  String

  dispatches     DispatchRecord[]
  doctors        DoctorProfile[]
}

// 5. Vehicle Entity
model Vehicle {
  id             Int       @id @default(autoincrement())
  licensePlate   String    @unique
  type           String    // e.g., Basic Life Support, Advanced Life Support
  isAvailable    Boolean   @default(true)

  dispatches     DispatchRecord[]
}

// 6. EmergencyAlert Entity
model EmergencyAlert {
  id             Int       @id @default(autoincrement())
  patientId      Int
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  latitude       Float
  longitude      Float
  status         AlertStatus    @default(PENDING)
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  dispatchRecord DispatchRecord?

  @@index([status])
}

// 7. DispatchRecord Entity (Relationship Table)
model DispatchRecord {
  id                           Int            @id @default(autoincrement())
  alertId                      Int            @unique
  alert                        EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)
  
  doctorId                     Int?
  doctor                       DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  
  vehicleId                    Int?
  vehicle                      Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  
  hospitalId                   Int?
  hospital                     Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  
  dispatchedAt                 DateTime       @default(now())
  completedAt                  DateTime?

  // Audit trail snapshots preserving responder identity even if accounts are modified
  doctorNameSnapshot           String?
  doctorSpecializationSnapshot String?
  doctorPhoneSnapshot          String?
  vehiclePlateSnapshot         String?
  hospitalNameSnapshot         String?

  feedback                     Feedback?
}

// 8. Feedback Entity
model Feedback {
  id               Int            @id @default(autoincrement())
  dispatchRecordId Int            @unique
  dispatchRecord   DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)
  
  userId           Int
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating           Int            // 1-5
  comments         String?
  createdAt        DateTime       @default(now())
}

// 9. Cold Storage Archive Models (Critique #16)
model EmergencyAlertArchive {
  id          Int       @id
  patientId   Int?
  latitude    Float?
  longitude   Float?
  status      String?
  description String?
  createdAt   DateTime?
  archivedAt  DateTime  @default(now())
}

model DispatchRecordArchive {
  id                           Int       @id
  alertId                      Int?
  doctorId                     Int?
  vehicleId                    Int?
  hospitalId                   Int?
  dispatchedAt                 DateTime?
  completedAt                  DateTime?
  doctorNameSnapshot           String?
  doctorSpecializationSnapshot String?
  doctorPhoneSnapshot          String?
  vehiclePlateSnapshot         String?
  hospitalNameSnapshot         String?
  archivedAt                   DateTime  @default(now())
}

model FeedbackArchive {
  id               Int       @id
  dispatchRecordId Int?
  userId           Int?
  rating           Int?
  comments         String?
  createdAt        DateTime?
  archivedAt       DateTime  @default(now())
}

model AlertStatusAuditArchive {
  auditId    Int       @id
  alertId    Int
  oldStatus  String?
  newStatus  String?
  changedAt  DateTime?
  archivedAt DateTime  @default(now())
}


