# Backend Server Environment Configuration
PORT=3000

# PostgreSQL Database Connection String (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/medrelay?schema=public"

# JWT Secret for Session Signing
JWT_SECRET="medrelay_secure_jwt_secret_change_me_in_production"

# Evaluator Demo Mode (Set to true strictly for evaluation and grading demonstrations; returns 404 in production)
DEMO_MODE="false"

# Local Ollama AI LLM Engine (Self-hosted, private medical triage)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="phi3:latest"

